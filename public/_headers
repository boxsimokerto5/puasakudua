# Cloudflare Pages Headers Configuration

# Default: Jangan cache index.html dan file routing agar selalu fresh
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Service Worker dan file versi jangan pernah di-cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# File assets (JS, CSS, fonts, gambar statis ber-hash) boleh di-cache permanen
/assets/*
  Cache-Control: public, max-age=31536000, immutable
